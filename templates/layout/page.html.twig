{#
/**
 * @file
 * Theme override to display a single page.
 *
 * This keeps Emulsify's page-level wrapper owned by the parent theme so
 * generated child themes do not need to rely on stable9 for the default page
 * structure.
 *
 * @see template_preprocess_page()
 * @see html.html.twig
 */
#}
{%
  set page_classes = [
    'section',
    'page',
  ]
%}
{% set page_attributes = {
  class: page_classes,
} %}
<div{{ add_attributes(page_attributes) }}>

{% block page_header %}
  {{ page.header }}
  {{ page.status }}
{% endblock %}

{% block page_main %}
  <main class="section main" role="main">
    <a id="main-content" tabindex="-1"></a>
    {{ page.breadcrumb }}
    {{ page.highlighted }}
    {{ page.content_top }}
    {{ page.sidebar_first }}
{% block page_content %}
    {{ page.content }}
{% endblock %}
    {{ page.sidebar_second }}
    {{ page.content_bottom }}
  </main>
{% endblock %}

{% block page_footer %}
  {{ page.footer }}
{% endblock %}

</div>{# /.layout-container #}
