  {
    "id": "bem-modifier-values",
    "helper": "bem",
    "args": [
      "card",
      [
        "large",
        "",
        null,
        "a b",
        0,
        false,
        [
          "nested"
        ]
      ],
      "layout",
      [
        "u:wide",
        "2xl"
      ]
    ],
    "divergence": "PHP ignores nested modifier lists; JavaScript flattens them. Both ignore false, but class sanitization and numeric class prefixes differ.",
    "php": {
      "attributes": {
        "class": [
          "layout__card",
          "layout__card--large",
          "layout__card--a b",
          "layout__card--0",
          "u:wide",
          "2xl"
        ]
      },
      "html": " class=\"layout__card layout__card--large layout__card--a b layout__card--0 u:wide 2xl\"",
      "contextAfter": {}
    },
    "js": {
      "attributes": {
        "class": [
          "layout__card",
          "layout__card--large",
          "layout__card--a",
          "b",
          "layout__card--0",
          "layout__card--nested",
          "u-wide",
          "_2xl"
        ]
      },
      "html": "class=\"layout__card layout__card--large layout__card--a b layout__card--0 layout__card--nested u-wide _2xl\"",
      "contextAfter": {}
    }
  },
  {
    "id": "bem-unusual-class",
