        ]
      },
      "html": "class=\"nicode card-1 card-1--wide space u-wide _2xl\"",
      "contextAfter": {}
    }
  },
  {
    "id": "bem-array-context",
    "helper": "bem",
    "context": {
      "id": "existing",
      "class": [
        "context",
        "button"
      ]
    },
    "args": [
      "button",
      [
        "wide"
      ]
    ],
    "divergence": "PHP retains a plain-array caller context; JavaScript clears it. Serialization order and leading whitespace differ.",
    "php": {
      "attributes": {
        "id": "existing",
        "class": [
          "button",
          "button--wide",
          "context"
        ]
      },
      "html": " id=\"existing\" class=\"button button--wide context\"",
      "contextAfter": {
        "id": "existing",
        "class": [
          "context",
          "button"
        ]
      }
    },
    "js": {
      "attributes": {
        "class": [
          "button",
          "button--wide",
          "context"
        ],
        "id": "existing"
      },
      "html": "class=\"button button--wide context\" id=\"existing\"",
      "contextAfter": {}
    }
  },
