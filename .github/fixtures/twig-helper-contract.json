  {
    "id": "bem-object-block-element",
    "helper": "bem",
    "args": [
      {
        "block": "card",
        "element": "title",
        "modifiers": [
          "red"
        ]
      }
    ],
    "divergence": "PHP treats block as base and element as prefix; JavaScript uses conventional block__element.",
    "php": {
      "attributes": {
        "class": [
          "title__card",
          "title__card--red"
        ]
      },
      "html": " class=\"title__card title__card--red\"",
      "contextAfter": {}
    },
    "js": {
      "attributes": {
        "class": [
          "card__title",
          "card__title--red"
        ]
      },
      "html": "class=\"card__title card__title--red\"",
      "contextAfter": {}
    }
  },
  {
    "id": "bem-object-aliases",
    "helper": "bem",
    "args": [
      {
        "baseClass": "button",
        "blockName": "card"
      }
    ],
    "divergence": "JavaScript accepts camelCase aliases that PHP does not.",
    "php": {
      "attributes": {},
      "html": "",
      "contextAfter": {}
    },
    "js": {
      "attributes": {
        "class": [
          "card__button"
        ]
