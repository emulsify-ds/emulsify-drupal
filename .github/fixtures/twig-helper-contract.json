  {
    "id": "add-arrays",
    "helper": "add_attributes",
    "context": {
      "class": [
        "base",
        "shared"
      ],
      "aria-describedby": [
        "old",
        "same"
      ]
    },
    "args": [
      {
        "class": [
          "shared",
          "new"
        ],
        "aria-describedby": [
          "new",
          "same"
        ]
      }
    ],
    "divergence": "PHP appends non-class arrays; JavaScript replaces them. Plain-array context consumption differs. Drupal serialization also deduplicates non-class arrays without mutating the returned attribute map.",
    "php": {
      "attributes": {
        "class": [
          "base",
          "shared",
          "new"
        ],
        "aria-describedby": [
          "old",
          "same",
          "new",
          "same"
        ]
      },
      "html": " class=\"base shared new\" aria-describedby=\"old same new\"",
      "contextAfter": {
        "class": [
          "base",
          "shared"
        ],
        "aria-describedby": [
          "old",
          "same"
        ]
      }
    },
    "js": {
      "attributes": {
        "class": [
          "base",
          "shared",
          "new"
        ],
        "aria-describedby": [
          "new",
          "same"
        ]
      },
      "html": "class=\"base shared new\" aria-describedby=\"new same\"",
      "contextAfter": {}
    }
  },
  {
    "id": "add-false-empty-null",
    "helper": "add_attributes",
    "context": {
      "hidden": true,
      "title": "before",
      "data-null": "before"
    },
    "args": [
      {
        "hidden": false,
        "title": "",
        "data-null": null,
        "class": [
          true,
          false,
          0,
          null,
          ""
        ]
      }
    ],
    "divergence": "PHP retains false booleans, skips empty non-class strings, and stringifies boolean class values; JavaScript ignores false attributes, retains empty strings, and drops falsy class tokens. Drupal serialization drops the string zero from class lists even though the map retains it.",
    "php": {
      "attributes": {
        "hidden": false,
        "title": "before",
        "data-null": "before",
        "class": [
          "true",
          "false",
          "0"
        ]
      },
      "html": " title=\"before\" data-null=\"before\" class=\"true false\"",
      "contextAfter": {
        "hidden": true,
        "title": "before",
        "data-null": "before"
      }
    },
    "js": {
      "attributes": {
        "hidden": true,
        "title": "",
        "data-null": "before",
        "class": [
          "true"
        ]
      },
      "html": "hidden title=\"\" data-null=\"before\" class=\"true\"",
      "contextAfter": {}
    }
  },
  {
    "id": "add-escaping",
    "helper": "add_attributes",
    "contextKind": "object",
    "context": {
      "id": "old"
    },
    "args": [
      {
        "title": "A & \"B\" <C> 'D'",
        "data-count": 0,
        "disabled": true
      }
    ],
    "divergence": "PHP emits a leading space and preserves numeric attribute types; JavaScript renders without that space and stringifies numeric attributes. PHP escapes apostrophes as &#039; whereas JavaScript leaves them literal inside double-quoted attributes.",
    "php": {
      "attributes": {
        "id": "old",
        "title": "A & \"B\" <C> 'D'",
        "data-count": 0,
        "disabled": true
      },
      "html": " id=\"old\" title=\"A &amp; &quot;B&quot; &lt;C&gt; &#039;D&#039;\" data-count=\"0\" disabled",
      "contextAfter": {}
    },
    "js": {
      "attributes": {
        "id": "old",
        "title": "A & \"B\" <C> 'D'",
        "data-count": "0",
        "disabled": true
      },
      "html": "id=\"old\" title=\"A &amp; &quot;B&quot; &lt;C&gt; 'D'\" data-count=\"0\" disabled",
      "contextAfter": {}
    }
  },
